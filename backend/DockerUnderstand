# STAGE 1: Build the JAR using Maven
FROM eclipse-temurin:21-jdk-alpine AS builder

# Set working directory inside container
WORKDIR /app

# Copy pom.xml first (so Maven deps are cached separately)
# Download all dependencies
COPY pom.xml .
RUN mvn dependency:go-offline -q

# Now copy your source code
COPY src ./src

# Build the JAR
RUN mvn clean package -DskipTests -q

# ─────────────────────────────────────────
# STAGE 2: Run the JAR in a smaller image
# ─────────────────────────────────────────
FROM eclipse-temurin:21-jre-alpine

WORKDIR /demo

# Copy only the JAR from Stage 1
COPY --from=builder /demo/target/*.jar app.jar

# Tell Docker your app runs on port 8080
EXPOSE 8080

# Command to run when container starts
ENTRYPOINT ["java", "-jar", "app.jar"]

